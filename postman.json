{
  "info": {
    "_postman_id": "c1e6c7c3-9c85-4c28-9e15-ticketing-system",
    "name": "Ticketing System Service",
    "description": "Incremental API collection for the Pridesys ticketing system assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "resetToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Foundation",
      "item": [
        {
          "name": "API health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('reports healthy status', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"
          ] } }]
        },
        {
          "name": "Actuator health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('reports healthy status', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"
          ] } }]
        }
      ]
    },
    {
      "name": "Auth and profile",
      "item": [
        {
          "name": "Login - client user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"client.user@example.com\",\n  \"password\": \"Password123!\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('returns a JWT', function () { pm.expect(pm.response.json().token).to.be.a('string').and.not.empty; });",
            "pm.collectionVariables.set('token', pm.response.json().token);"
          ] } }]
        },
        {
          "name": "Get my profile",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api", "me"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('does not expose password data', function () { pm.expect(pm.response.text()).not.to.include('password'); });"
          ] } }]
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Client User Updated\",\n  \"mobile\": \"01700000003\",\n  \"designation\": \"Support User\",\n  \"office\": \"Dhaka\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api", "me"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Change my password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"Password123!\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/me/change-password", "host": ["{{baseUrl}}"], "path": ["api", "me", "change-password"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Forgot password (read token from API log)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"client.user@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "forgot-password"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('does not expose reset token field', function () { pm.expect(pm.response.json()).not.to.have.property('resetToken'); });"
          ] } }]
        },
        {
          "name": "Reset password (paste token first)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"Password123!\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "reset-password"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "Unauthenticated profile is rejected",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api", "me"] } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 401', function () { pm.response.to.have.status(401); });"] } }]
        }
      ]
    },
    {
      "name": "Users, clients, projects and modules",
      "item": [
        { "name": "List projects", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api","projects"] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });"] } }] },
        { "name": "List users (admin)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/users?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["api","users"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });"] } }] },
        { "name": "List clients (app admin)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/clients", "host": ["{{baseUrl}}"], "path": ["api","clients"] } } },
        { "name": "Create project (app admin)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Customer Portal\",\n  \"shortCode\": \"PORTAL\",\n  \"description\": \"Customer support portal\"\n}" }, "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api","projects"] } } },
        { "name": "List project modules", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/projects/1/modules", "host": ["{{baseUrl}}"], "path": ["api","projects","1","modules"] } } }
      ]
    }
  ]
}
